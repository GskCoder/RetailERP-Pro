# === RetailERP Backend Environment Variables ===

# PostgreSQL connection string (from Neon, Supabase, Railway, etc.)
# For local dev with SQLite, comment this out or leave it as-is
DATABASE_URL=sqlite:///./retailerp.db

# For production (Neon PostgreSQL), use something like:
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Secret — MUST be a fixed value in production (not auto-generated)
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-real-secret-key

# Frontend URL for CORS — set to your Vercel deployment URL
FRONTEND_URL=http://localhost:5173
# For production: FRONTEND_URL=https://your-app.vercel.app
